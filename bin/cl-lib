#!/usr/bin/env bash

# Requires "glab": https://docs.gitlab.com/ee/editor_extensions/gitlab_cli/

GITLAB_ROOT_DIR="${CF-${HOME}/gitlab}"
GITLAB_ROOT_GROUP="therootgroup"


function must_have_succeeded {
  local ret=$?; if [ $ret -ne 0 ]; then echo "$@" >&2; exit $ret; fi
}

# find_repos <search>
function find_repos {
    local search="${1}"
    local query=$(cat <<EOF
{
  group(fullPath: "${GITLAB_ROOT_GROUP}") {
    projects (includeSubgroups: true, search: "${search}", includeArchived: false ) {
      nodes {
        name
        description
        httpUrlToRepo
        nameWithNamespace
        path
        sshUrlToRepo
        webUrl
      }
    }
  }
}
EOF
)

    glab api graphql -f query="${query}" | cat
}

# path_from_webUrl <repo webUrl>
function path_from_webUrl {
    local webUrl="${1}"
    echo "${webUrl}" | sed -r "s_https?://[^/]+/${GITLAB_ROOT_GROUP}/(.+)_\1_g"
}

# pick_best_search_match <search query> <webUrl list>
function pick_best_search_match {
    local search="${1}"
    shift
    local webUrlList=("$@")

    if (( ${#webUrlList[@]} == 0 )); then
        return 1
    fi

    # return sole match
    if (( ${#webUrlList[@]} == 1 )); then
        echo ${webUrlList[0]}
        return
    fi

    # return perfect match
    matches=()
    for i in "${webUrlList[@]}"; do
        local projectName=$(basename "$i")
        if [ "$projectName" = "$search" ]; then
            matches+=($i)
        fi
    done

    if (( ${#matches[@]} == 1 )); then
        echo ${matches[0]}
        return
    fi

    # use "fzf" to select match
    local match=$(printf '%s\n' "${webUrlList[@]}" | fzf)
    echo "${match}"
    return
}

# find_local_project <webUrl>
function find_local_project {
    local webUrl="${1}"

    local project_path=$(path_from_webUrl "$webUrl")
    local project_path_full="${GITLAB_ROOT_DIR}/${project_path}"
    echo "$project_path_full"

    if [ ! -d "${project_path_full}" ]; then
        local parent=$(dirname "${project_path_full}")
        mkdir -p "$parent"
        cd "$parent"

        glab project clone "${GITLAB_ROOT_GROUP}/${project_path}" >&2
    fi
}

# Local Variables:
# mode: sh
# End:
