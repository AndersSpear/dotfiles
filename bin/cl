#!/usr/bin/env bash

# Requires "glab": https://docs.gitlab.com/ee/editor_extensions/gitlab_cli/

source cl-lib

function usage {
    echo "cl <project>"
    echo
    echo "Navigates to a local clone of <project>, cloning from gitlab if necessary"
}

if [[ $# -ne 1 ]]; then
    usage
    exit
fi

search="${1}"

# Get repository results from GitLab API
repoResults=$(find_repos "${search}")

# Check if JSON is valid
if ! echo "$repoResults" | jq -e . > /dev/null 2>&1; then
    echo "Error: Invalid JSON returned from GitLab API" >&2
    exit 1
fi

# Extract web URLs, safely handling empty arrays
if ! webUrlsJson=$(echo "$repoResults" | jq -r '.data.group.projects.nodes[].webUrl' 2>/dev/null); then
    echo "Error: No projects found or unexpected JSON structure" >&2
    exit 1
fi

# Convert to array, handling the case where there might be no results
readarray -t repoWebUrls < <(echo "$webUrlsJson")

# Check if we got any results
if [ ${#repoWebUrls[@]} -eq 0 ]; then
    echo "Error: No matching projects found" >&2
    exit 1
fi

match=$(pick_best_search_match "${search}" "${repoWebUrls[@]}")
must_have_succeeded

dir=$(find_local_project "$match")
must_have_succeeded

# Generate valid JSON output
jq -n --arg url "$match" --arg dir "$dir" '{url: $url, localDirectory: $dir}'

# Local Variables:
# mode: sh
# End:
